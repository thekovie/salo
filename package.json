{
  "name": "salo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests e2e next.config.ts drizzle.config.ts vitest.config.mts playwright.config.ts eslint.config.mjs",
    "typecheck": "next typegen && tsc --noEmit",

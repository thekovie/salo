# Copy to .env for local development. Production values live in Coolify's environment settings.

# The dedicated Salo PostgreSQL database (never Coolify's own coolify-db).
# Local: `pnpm db:up` starts one on 127.0.0.1:5433.
DATABASE_URL=postgres://salo@localhost:5433/salo

# Public address of the app: used for invite links, QR codes and link previews. https in production.
APP_URL=http://localhost:3000

# Retention (brief section 12). Closed sessions are deleted this many days after closing.
CLOSED_RETENTION_DAYS=7
NEW_ORDERS_PER_HOUR=20
# Sessions never closed are deleted after this many days without activity.
INACTIVE_RETENTION_DAYS=30
# PostHog (US cloud) project API key; leave empty to turn analytics off.
POSTHOG_KEY=
# Cloudflare Turnstile (bot check before starting an order); leave empty to skip the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
